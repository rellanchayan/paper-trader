# Copy to .env (NOT committed) and fill in real values. Never commit .env.

# Alpaca PAPER credentials — get from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=PK_paper_key_here
ALPACA_SECRET_KEY=secret_here
# DO NOT change to live endpoint. constitution.py + alpaca_client.py refuse anything else.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets

# Live trading authorization — must remain false. This project is paper-only.
# Even when set to true, constitution.py will continue to refuse anything but paper.
LIVE_TRADING_AUTHORIZED=false

# Optional: account ID for reference (not used by code, just logged).
ALPACA_ACCOUNT_ID=

# Optional: risk-free rate for Sharpe (decimal). Default in code is 0.045.
RISK_FREE_RATE=0.045
